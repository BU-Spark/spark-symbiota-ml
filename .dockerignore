# Secrets: injected at runtime via compose `env_file`, never baked into a layer.
# Patterns are anchored at the context root, so `**/` is required to catch
# transcription/.env -- a bare `.env` silently matches only the root file.
**/.env
**/*.env
!**/.env.example

# Virtualenvs and VCS metadata
.venv/
venv/
.git/
.gitignore

# Python caches. `**/` is required; a bare pattern matches only the root.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.ipynb_checkpoints/

# Sample imagery, eval outputs, notebooks, docs: not needed to serve the API
transcription/data/
transcription/results/

# ...except the files the runtime reads: the collector gazetteer for recordedBy
# confidence, and the GBIF lookup cache.
!transcription/data/gt-labels/collector_gt.txt
!transcription/data/new-england-samples/output/collectors.txt
!transcription/results/gbif_taxon_full.json
nbs/
docs/
memory/

# Build/editor cruft
docker/
Dockerfile*
*.md
.vscode/
.idea/
