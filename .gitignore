# --- Dev-only artifacts (not for commit) ---
# Claude Code local memory
memory/
# OCR cache (regenerated by nbs/ocr_cache.py; large, per-machine)
transcription/results/ocr_cache/
# Dev eval outputs (the canonical confidence_eval.csv is kept)
transcription/results/confidence_eval_*.csv
docs/confidence-summary.md
# Exploratory eval scripts stay local; the scripts the pipeline and the docs
# depend on are tracked explicitly below.
nbs/*
!nbs/README.md
# Dataset builders
!nbs/gbif_fetch.py
!nbs/gbif_refetch_occids.py
# Cache builders (inputs to every eval)
!nbs/ocr_cache.py
!nbs/self_consistency_cache.py
!nbs/vision_agreement_test.py
# Fit the shipped calibration maps
!nbs/fit_calibration.py
!nbs/fit_calibration_anthropic.py
# Evals cited in docs/azure-confidence-pipeline.md
!nbs/confidence_eval.py
!nbs/confidence_threshold_table.py
!nbs/roi_pareto_eval.py
# Cross-model comparison
!nbs/model_run.py
!nbs/model_compare.py
!nbs/model_agreement.py
!nbs/sonnet5_run.py
!nbs/sonnet5_hallucination.py
# Cross-pipeline
!nbs/cross_pipeline.py
!nbs/repeat_runs.py
# Three-pipeline confidence comparison
!nbs/confidence_compare.py
# Specimen sampling + hand labelling
!nbs/sample_from_export.py
!nbs/label_tool.py
!nbs/pilot_occids.txt
# Credential check
!nbs/check_google_creds.py
# Fit the shipped calibration maps
!nbs/fit_calibration_google.py
!nbs/fit_recordedby_calibration.py
!nbs/refit_location_calibration.py
# Validation cited in the status report
!nbs/validate_on_holdout.py
!nbs/out_of_domain_eval.py
!nbs/build_threshold_table.py
!nbs/holdout_occids.txt
# Notebooks
!nbs/*.ipynb
